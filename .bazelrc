common --platforms=//platforms:x86_64_linux_gcc11
common --host_platform=//platforms:x86_64_linux_gcc11
common --extra_toolchains=@gcc_toolchain_x86_64-gcc11//:cc_toolchain
common --extra_toolchains=@gcc_toolchain_x86_64-gcc11//:fortran_toolchain
# Analysis performance optimizations
common --experimental_repository_cache_hardlinks

# Platform specific configurations
build:aarch64 --platforms=//platforms:aarch64_linux_gcc13
build:aarch64 --platform_suffix=aarch64

build:gcc11 --platforms=//platforms:x86_64_linux_gcc11
build:gcc11 --platform_suffix=gcc11

# For the host you will have to run on Ubuntu 24.04 (eg via a docker container)
build:gcc13 --extra_toolchains=@gcc_toolchain_x86_64-gcc13//:cc_toolchain
build:gcc13 --extra_toolchains=@gcc_toolchain_x86_64-gcc13//:fortran_toolchain
build:gcc13 --platforms=//platforms:x86_64_linux_gcc13
build:gcc13 --platform_suffix=gcc13

build:aarch64 --extra_toolchains=@gcc_toolchain_aarch64-gcc13//:cc_toolchain
build:aarch64 --extra_toolchains=@gcc_toolchain_aarch64-gcc13//:fortran_toolchain
build:aarch64 --platforms=//platforms:aarch64_linux_gcc13
build:aarch64 --platform_suffix=aarch64

build:aarch64_gcc11 --extra_toolchains=@gcc_toolchain_aarch64-gcc11//:cc_toolchain
build:aarch64_gcc11 --extra_toolchains=@gcc_toolchain_aarch64-gcc11//:fortran_toolchain
build:aarch64_gcc11 --platforms=//platforms:aarch64_linux_gcc11
build:aarch64_gcc11 --platform_suffix=aarch64_gcc11

build:aarch64_qnx --fission=no
build:aarch64_qnx --platforms=//platforms:aarch64_qnx
build:aarch64_qnx --platform_suffix=aarch64_qnx
build:aarch64_qnx --extra_toolchains=@qnx_aarch64//:qcc

build:x86_64_qnx --fission=no
build:x86_64_qnx --platforms=//platforms:x86_64_qnx
build:x86_64_qnx --platform_suffix=x86_64_qnx
build:x86_64_qnx --extra_toolchains=@qnx_x86_64//:qcc

# Debugging and sanitizer configurations
build:debug --compilation_mode=dbg
build:debug --strip never
build:debug --platform_suffix=debug

# If you change these flags, please also update the documentation.
build:asan --features asan
build:asan --compilation_mode=fastbuild
build:asan --strip never
build:asan --action_env ASAN_OPTIONS=detect_leaks=0:color=always
build:asan --platform_suffix=asan

# If you change these flags, please also update the documentation.
build:lsan --features lsan
build:lsan --compilation_mode=fastbuild
build:lsan --strip never
build:lsan --action_env LSAN_OPTIONS=verbosity=1:log_threads=1:report_objects=1
build:lsan --platform_suffix=lsan

# If you change these flags, please also update the documentation.
build:tsan --features tsan
build:tsan --compilation_mode=fastbuild
build:tsan --strip never
build:tsan --action_env TSAN_OPTIONS=verbosity=3:halt_on_error=1:second_deadlock_stack=1
build:tsan --platform_suffix=tsan

# If you change these flags, please also update the documentation.
build:ubsan --features ubsan
build:ubsan --compilation_mode=fastbuild
build:ubsan --strip never
build:ubsan --action_env UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
build:ubsan --platform_suffix=ubsan