# Compiler version constraints
constraint_setting(
    name = "compiler_version",
    default_constraint_value = ":gcc13",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "gcc10",
    constraint_setting = ":compiler_version",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "gcc11",
    constraint_setting = ":compiler_version",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "gcc13",
    constraint_setting = ":compiler_version",
    visibility = ["//visibility:public"],
)

platform(
    name = "aarch64_linux_gcc13",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":gcc13",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "aarch64_linux_gcc11",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":gcc11",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "x86_64_linux_gcc13",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":gcc13",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "x86_64_linux_gcc11",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":gcc11",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "aarch64_qnx",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:qnx",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "x86_64_qnx",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:qnx",
    ],
    visibility = ["//visibility:public"],
)
